# --- Supabase project (same project as your main bookkeeping app) ---

# Project URL and publishable key - used for admin login (Supabase Auth)
# and for validating the logged-in user's token server-side.
# Find these in Supabase Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Secret key - SERVER-SIDE ONLY, never exposed to the browser.
# Used to read subscriber/subscription metrics regardless of RLS policies
# written for the main app. Keep this secret. Do not prefix with NEXT_PUBLIC_.
# Find it in Supabase Dashboard > Project Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# --- Dashboard access control ---

# Comma-separated list of email addresses (must match an existing
# auth.users account in this Supabase project) allowed to log into
# this dashboard. Anyone else who signs in will be signed out immediately.
ALLOWED_ADMIN_EMAILS=you@example.com

